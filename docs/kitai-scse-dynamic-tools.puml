@startuml
title Проектная архитектура безопасности SCSE MCP

left to right direction
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false

actor "Пользователь" as User

package "AI HUB" {
    component "ИИ-агент" as Agent
    component "KitAI Core\nMCP Proxy" as Core
}

package "Общая библиотека\nmcp-security-starter" as SecurityLibrary {
    component "Приём входного\nsecurity-контекста" as InboundSecurity
    component "Валидатор JWT\nAI HUB" as CoreJwtValidator
    component "Валидатор JWT\nСУДИР" as SudirJwtValidator
    component "Валидатор JWT\nповерхности" as SurfaceJwtValidator
    component "Разбор и проверка\nAgentInfo" as AgentInfoResolver
    component "Фабрика\nMcpCallerContext" as ContextFactory
    component "Token Relay\nдля исходящих запросов" as TokenRelay
    component "Безопасное логирование\nбез значений токенов" as SecurityAudit
}

package "SCSE MCP — отдельный сервис" as McpService {
    component "Streamable HTTP\n/mcp" as McpEndpoint
    component "Интеграция с\nmcp-security-starter" as SecurityAdapter

    component "MCP Protocol Adapter\ntools/list, tools/call" as McpProtocol
    component "SCSE Authorization Engine" as AuthorizationEngine
    database "Политики доступа SCSE\nuser × agent × surface × tool\nреализация TBD" as PolicyRepository

    component "Каталог динамических tools\ntool <-> templateId" as ToolCatalog
    component "Tool Dispatcher" as ToolDispatcher
    component "SCSE Backend Client" as BackendClient
}

package "SCSE Backend" as ScseBackend {
    component "Backend JWT Security" as BackendSecurity
    component "MCP Templates API" as TemplatesApi
    component "Query Execution API" as QueryApi
}

cloud "СУД AI HUB\nissuer/JWKS" as AiHubIam
cloud "СУДИР\nissuer/JWKS" as Sudir
cloud "СУД поверхности\nissuer/JWKS — TBD" as SurfaceIam

component "MCP-серверы\nдругих команд" as OtherMcp

User --> Agent : бизнес-запрос
Agent --> Core : запрос к tool

Core --> McpEndpoint : Streamable HTTP + MCP JSON-RPC\nAI HUB JWT [опционально]\nСУДИР JWT [обязательно]\nSurface JWT [контракт TBD]\nAgentInfo [формат TBD]

McpEndpoint --> SecurityAdapter
SecurityAdapter ..> InboundSecurity : использует библиотеку

InboundSecurity --> CoreJwtValidator
InboundSecurity --> SudirJwtValidator
InboundSecurity --> SurfaceJwtValidator
InboundSecurity --> AgentInfoResolver

CoreJwtValidator --> AiHubIam : ключи и параметры проверки
SudirJwtValidator --> Sudir : ключи и параметры проверки
SurfaceJwtValidator --> SurfaceIam : ключи и параметры проверки

CoreJwtValidator --> ContextFactory : core identity / отсутствует
SudirJwtValidator --> ContextFactory : user identity
SurfaceJwtValidator --> ContextFactory : surface identity
AgentInfoResolver --> ContextFactory : agent identity
ContextFactory --> SecurityAdapter : McpCallerContext
ContextFactory --> SecurityAudit : обезличенные идентификаторы

SecurityAdapter --> McpProtocol : только валидированный контекст

McpProtocol --> ToolCatalog : tools/list
ToolCatalog --> AuthorizationEngine : фильтровать tools

McpProtocol --> ToolDispatcher : tools/call
ToolDispatcher --> AuthorizationEngine : повторно проверить конкретный tool

AuthorizationEngine --> PolicyRepository : evaluate(context, tool, action)
AuthorizationEngine --> ToolCatalog : разрешённый набор
AuthorizationEngine --> ToolDispatcher : permit / deny

ToolCatalog --> BackendClient : получить задекларированные шаблоны
ToolDispatcher --> BackendClient : выполнить templateId

BackendClient ..> TokenRelay : выбрать токен для backend
TokenRelay --> BackendSecurity : Authorization: Bearer <СУДИР JWT>
BackendSecurity --> TemplatesApi
BackendSecurity --> QueryApi

OtherMcp ..> SecurityLibrary : подключает как зависимость

note top of McpEndpoint
Имена HTTP-заголовков и способ передачи
трёх токенов должны быть определены
отдельным интеграционным контрактом.

JWT не передаются в аргументах tool.
end note

note bottom of ContextFactory
McpCallerContext содержит проверенные идентичности:
- userId / роли пользователя;
- agentId;
- surfaceId;
- core/client identity, если AI HUB JWT передан.

Прикладной код не работает с сырыми JWT.
end note

note bottom of AuthorizationEngine
SCSE MCP владеет прикладным решением о доступе.
Библиотека подтверждает идентичности и доставляет токены,
но не знает SCSE-правил для шаблонов и tools.
end note

note bottom of AgentInfoResolver
AgentInfo нельзя считать доверенным только потому,
что клиент прислал agentId. Идентичность агента должна
быть связана с подписанным JWT либо с аутентифицированным
каналом KitAI Core. Точный механизм — TBD.
end note

note bottom of TokenRelay
В SCSE Backend передаётся только предназначенный ему токен.
AI HUB JWT и Surface JWT не прокидываются автоматически.
end note

@enduml
